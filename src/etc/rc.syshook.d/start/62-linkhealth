# core updates replace the GUI translation catalogs; add the Link Health strings back
ADDED=$(/usr/local/opnsense/scripts/linkhealth/merge_ui_translations.py 2> /dev/null)
if [ -n "${ADDED}" ] && [ "${ADDED}" != "0" ]; then
	# running php processes keep the old catalog in memory
	configctl webgui restart > /dev/null 2>&1
fi
